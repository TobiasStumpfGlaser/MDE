<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground">

    <!-- TOOLBAR (UNCHANGED) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:elevation="4dp"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_launcher_foreground"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"/>

            <TextView
                android:id="@+id/txtHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BW MDE"
                android:textSize="25sp"
                android:textStyle="bold"/>
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- SCROLL -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- MATERIAL -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnMaterialBook"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="📦  Materialbuchung  ➕➖"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <View android:layout_height="12dp" android:layout_width="match_parent"/>

            <!-- PICKLIST -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnPicklist"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="📋  Picklisten  ➡️"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <View android:layout_height="12dp" android:layout_width="match_parent"/>

            <!-- DROPLIST -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnDroplist"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="📋  Droplisten  ⬅️"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <View android:layout_height="12dp" android:layout_width="match_parent"/>

            <!-- BESTELLUNG -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnBestellung"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="🛒  Bestellung  🚚"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

            <View android:layout_height="12dp" android:layout_width="match_parent"/>

            <!-- INVENTUR -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnInventur"
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:text="📊  Inventur  🟰"
                android:textAllCaps="false"
                android:textSize="22sp"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>